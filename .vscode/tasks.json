{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build",
      "type": "process",
      "command": "${workspaceFolder}/build.bat",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CMake: Configure",
      "type": "process",
      "command": "${workspaceFolder}/build.bat",
      "args": ["configure"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "CMake: Clean & Rebuild",
      "type": "process",
      "command": "${workspaceFolder}/build.bat",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "group": "build"
    },
    {
      "label": "Run FEA Pre-Processor",
      "type": "process",
      "command": "${workspaceFolder}/build.bat",
      "args": ["run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: Build",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}