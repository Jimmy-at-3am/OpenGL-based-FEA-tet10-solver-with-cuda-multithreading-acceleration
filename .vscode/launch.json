{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch FEA Pre-Processor",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/FEAPreProcessor.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build",
      "preLaunchTask": "CMake: Build"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "${workspaceFolder}/src",
      "program": "${workspaceFolder}/build/Debug/outDebug",
      "MIMode": "lldb",
      "miDebuggerPath": "nonexistent",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}