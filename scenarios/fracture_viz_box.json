{
  "v": 1,
  "geometry": { "preset": "box", "size": [2.0, 1.0, 1.0] },
  "material": "materials/pla.mat",
  "mesh": { "maxVolume": 0.05, "quality": 1.6 },
  "loads": [ { "type": "preset", "name": "tensionZ", "mag": 3.0e7 } ],
  "constraints": [ { "preset": "fixedMinX" } ],
  "solve": { "kind": "fracture", "maxIter": 50, "gpu": false, "fdmAnisotropy": true, "buildAxis": 2 },
  "probes": [
    { "id": "freeEndTop", "pos": [1.0, 0.5, 0.0], "quantity": "displacement" }
  ],
  "screenshots": [
    { "name": "deform",       "camera": "iso", "scalarMode": 1, "deformScale": 0.0, "deadView": "hidden"  },
    { "name": "mode",         "camera": "iso", "scalarMode": 3, "deformScale": 0.0, "deadView": "colored" },
    { "name": "crack_order",  "camera": "iso", "scalarMode": 4, "deformScale": 0.0, "deadView": "colored" },
    { "name": "stress",       "camera": "iso", "scalarMode": 5, "deformScale": 0.0, "deadView": "colored" },
    { "name": "mode_ghost",   "camera": "iso", "scalarMode": 3, "deformScale": 0.0, "deadView": "ghost"   },
    { "name": "mode_colored", "camera": "iso", "scalarMode": 3, "deformScale": 0.0, "deadView": "colored" }
  ],
  "asserts": [
    { "path": "mesh.nTets", "op": ">", "value": 0 },
    { "path": "solver.ok", "op": "==", "value": 1 },
    { "path": "fracture.totalFailed", "op": ">", "value": 0 },
    { "path": "fracture.byMode.interlayerTension", "op": ">", "value": 0 },
    { "path": "screenshots.deform.stdRGBmax", "op": ">", "value": 12.0 },
    { "path": "screenshots.mode_colored.uniqueColors", "op": ">=", "value": 4 }
  ]
}
